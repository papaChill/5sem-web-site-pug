back(size)
    background-color #f1f1f1
    box-shadow 4px 5px 10px rgba(0, 0, 0, 0.4)
    padding: size + "%"
    margin 0 auto 1% auto 
        
section-style(number)   
    align-items center
    back(number)    
    & h3
        grid-column 1/-1
        margin 0
        text-align center
    & img
        border-radius 3%
        width: 100%    
    & p 
        text-align justify
    & ul
        list-style-position inside
        padding 0
        text-align left
        width 100%
        max-width 500px   


colorText = #6f6d6d

html
  color colorText

.main-header
    display flex
    justify-content space-between
    align-items center
    back(0)
    background-color #f87777 
    & h2
        color #f8f8f8
        margin 0
        padding 15px
    & .search-box
        display flex
        padding 15px    
        & input
            padding 5px 10px
            border none
            border-radius 4px 0 0 4px       
        & button
            padding 5px 10px
            border none
            background-color #a80404
            color white
            border-radius 0 4px 4px 0 
            &:hover
                background-color #5c0808
        

nav
    back(0)
    margin 0 auto
    text-align center
    & a
        display inline-block
        padding 1%
        color colorText
        text-decoration: none       
        &:hover
        &.active
            background-color #f87777
            color #f8f8f8   


div.images
    display grid
    grid-template-columns 1fr 1fr 1fr
    grid-auto-rows 180px 
    grid-gap 10px
    width 80%
    margin 0 auto
    back(1)

    & img
        width 100%
        height 100%
        object-fit cover 

    & a
        display block
        width 100%
        height 100%
        overflow hidden 
    & .big
        grid-column span 2 
        
        
.container-table
    width 90%
    margin 20px auto
    back(1)
    padding 20px

    & fieldset
        border 1px solid #ccc
        border-radius 5px
        margin-bottom 10px
        & summary
            font-size 1.2rem
            padding 5px

    & table.cars-data-table
        width 100%
        border-collapse collapse       
        & th, & td
            border 1px solid #ddd
            padding 10px
            text-align left        
        & th
            background-color #f87777
            color white
            

car
    width 80%
    section-style(2) 
    display block
    text-align center
    border-radius 3%
    overflow hidden
    & img
        object-fit cover
        height 100%
        width 100%
    & .inside
        display grid
        grid-template-columns 1fr 1fr
        grid-gap 5%
        &.container
            display flex
            flex-direction columns
            padding 5%
            margin 5%
        

main
    display grid
    grid-template-columns: 1fr 5fr 1fr
    grid-gap 3%
    & center
        & front
            display grid
            grid-template-columns repeat(2, 1fr)
            grid-template-rows repeat(2, 1fr)
            grid-gap 5%
            & .card                
                section-style(2)
                border-radius 3%
                .L
                    text-align left
                .R
                    text-align right
                & .btn                                            
                    padding 10px 20px                
                    background-color #f87777                
                    color white                
                    border none                
                    border-radius 5px                                        
                    margin-top 15px
                    &:hover
                        background-color #5c0808                
                &.W
                    grid-column span 2                
                    display flex
                    align-items stretch
                    overflow hidden
                    & h3
                        font-size 1.5rem
                    & .info
                        flex 2
                        padding 20px
                        text-align right
                        & p
                            margin-top 0px
                    & img
                        width 50%
                        object-fit cover
                        height 100%
    & side
        display flex
        flex-direction column
        .artic
            border-radius 3%
            section-style(2)
            display grid
            margin-bottom 15px
            text-align center


footer
    background-color colorText
    & h4
        padding 5px
        color #f8f8f8


@media (max-width: 700px)

    main
        & side:last-of-type
            display none
        grid-template-columns: 1fr
        grid-gap 1px
        & center
            & front
                grid-template-columns 1fr
                grid-gap 1px
                & .card 
                    &.W
                        flex-direction column
                        grid-column 1
                        & img
                            width 100%
                            height 550px
                            object-fit cover
                        
    car
        & .inside
            grid-template-columns 1fr
            
    div.images    
        grid-template-columns 1fr       
        & img
            margin 0 auto           

    section
        grid-template-columns 1fr

